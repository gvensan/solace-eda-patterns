# Copy to .env.dev and change what you need. ./dev.sh reads it.
# The defaults match the broker setup_broker.sh starts in a Codespace.

# If something on your machine already uses 8080 or 55555, run this
# workshop's broker on other ports:
# SOLACE_SEMP_PORT=18080
# SOLACE_SMF_PORT=15555
# Leave out the MQTT, REST, AMQP and web messaging ports, which the dashboard
# does not use, when they clash with something else:
# SOLACE_MAP_EXTRA_PORTS=false

# Broker version and container name:
# SOLACE_BROKER_VERSION=10.26.0
# SOLACE_BROKER_NAME=solace_10.26.0

# A different broker altogether. Clear broker config deletes every object any
# scenario lists in imports.tsv, so only point this at a broker you can clean.
# SOLACE_HOST=localhost
# SOLACE_SEMP_USER=admin
# SOLACE_SEMP_PASSWORD=admin
# SOLACE_MSG_VPN=default
# SOLACE_CLIENT_PASSWORD=solace-workshop

# Dashboard port:
# COCKPIT_PORT=3000
